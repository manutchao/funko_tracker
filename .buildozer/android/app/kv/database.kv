<DatabaseScreen>:
    BoxLayout:
        orientation: "vertical"
        padding: dp(8)
        spacing: dp(8)

        # Zone scrollable (prend le reste de l'écran)
        ScrollView:
            size_hint_y: 1
            bar_width: dp(8)
            padding: [0, 0, 0, dp(56)]  # <-- clé du problème

            MDList:
                id: data_list

        # Footer FIXE
        MDBoxLayout:
            size_hint_y: None
            height: dp(64)
            spacing: dp(12)
            padding: [dp(12), dp(8)]
            md_bg_color: app.theme_cls.bg_dark

            MDRaisedButton:
                id: prev_button
                text: "Previous"
                on_release: root.previous_page()

            MDLabel:
                id: page_label
                text: "Page 1"
                halign: "center"
                valign: "middle"

            MDRaisedButton:
                id: next_button
                text: "Next"
                on_release: root.next_page()
